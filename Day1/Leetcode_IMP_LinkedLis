//Array to LL
class Solution {
    public Node arrayToList(int arr[]) {
        // code here
        Node head = new Node(arr[0]);
        Node current = head;
        for (int i = 1; i < arr.length; i++) {
            current.next = new Node(arr[i]);
            current = current.next;
        }
        return head;
    }
}

// Search in LL
class Solution1 {
    public boolean searchKey(Node head, int key) {
        // Code here
        Node curr = head;
        while (curr != null) {
            if (curr.data == key) {
                return true;
            }
            curr = curr.next;
        }
        return false;
    }
}

// Linked list end insertion
class Solution2 {
    public Node insertAtEnd(Node head, int x) {
        // code here
        Node newNode = new Node(x);
        if (head == null) {
            return newNode;
        }
        Node curr = head;
        while (curr.next != null) {
            curr = curr.next;
        }
        curr.next = newNode;
        return head;
    }
}

//leetcode 19
class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode dummy=new ListNode(0);
        dummy.next=head;
        ListNode slow=dummy;
        ListNode fast=dummy;
        for(int i=0;i<=n;i++){
            fast=fast.next;
        }
        while(fast!=null){
        slow=slow.next;
        fast=fast.next;
        }
        slow.next=slow.next.next;
        return dummy.next;
    }
}

//leetcode 160
public class Solution {
    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {
    ListNode a=headA;
    ListNode b=headB;
    while(a!=b){
        a=(a==null) ? headB : a.next;
        b=(b==null) ? headA: b.next;
        
    }
    return b;
    }
}


// leetcode 328
class Solution {
    public ListNode oddEvenList(ListNode head) {
        if (head == null || head.next == null) {
            return head;
        }
        ListNode odd = head;
        ListNode even = head.next;
        ListNode evenHead = even;
        while (even != null && even.next != null) {
            odd.next = even.next;
            odd = odd.next;
            even.next = odd.next;
            even = even.next;   // Missing line
        }
        odd.next = evenHead;
        return head;
    }
}

// leetcode 876
class Solution {
    public ListNode middleNode(ListNode head) {
        ListNode slow=head;
        ListNode fast= head;
        while (fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        return slow;
