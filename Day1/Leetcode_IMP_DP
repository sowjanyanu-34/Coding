//DP pattern 
//leetcode 70
class Solution {
    public int climbStairs(int n) {
        if (n <= 2) return n;
        int a = 1;
        int b = 2;
        for (int i = 3; i <= n; i++) {
            int c = a + b;
            a = b;
            b = c;
        }
        return b;
    }
}

//leetcode 198
class Solution {
    public int rob(int[] nums) {

        int prev2 = 0;
        int prev1 = 0;

        for (int money : nums) {

            int current = Math.max(
                prev1,
                money + prev2
            );

            prev2 = prev1;
            prev1 = current;
        }

        return prev1;
    }
}
