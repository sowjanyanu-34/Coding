//Array to LL
class Solution {
    public Node arrayToList(int arr[]) {
        // code here
        Node head = new Node(arr[0]);
        Node current = head;
        for (int i = 1; i < arr.length; i++) {
            current.next = new Node(arr[i]);
            current = current.next;
        }
        return head;
    }
}

// Search in LL
class Solution1 {
    public boolean searchKey(Node head, int key) {
        // Code here
        Node curr = head;
        while (curr != null) {
            if (curr.data == key) {
                return true;
            }
            curr = curr.next;
        }
        return false;
    }
}

// Linked list end insertion
class Solution2 {
    public Node insertAtEnd(Node head, int x) {
        // code here
        Node newNode = new Node(x);
        if (head == null) {
            return newNode;
        }
        Node curr = head;
        while (curr.next != null) {
            curr = curr.next;
        }
        curr.next = newNode;
        return head;
    }
}

//leetcode 19
class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode dummy=new ListNode(0);
        dummy.next=head;
        ListNode slow=dummy;
        ListNode fast=dummy;
        for(int i=0;i<=n;i++){
            fast=fast.next;
        }
        while(fast!=null){
        slow=slow.next;
        fast=fast.next;
        }
        slow.next=slow.next.next;
        return dummy.next;
    }
}

